<Project Sdk="Microsoft.NET.Sdk">
  <!-- Décode WorldMapOverlay et WorldMapOverlayTile (DB2) en TSV. Lancé par Tools\worldmap\run.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- DBCD (MIT) : lecture des DB2 avec les définitions de WoWDBDefs. -->
    <PackageReference Include="DBCD" Version="2.3.1" />
  </ItemGroup>
</Project>
